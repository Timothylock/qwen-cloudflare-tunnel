# Copy to .env on the NAS and edit. .env itself never leaves the NAS.

# GHCR release to run (built by GitHub Actions from the matching git tag).
IMAGE_TAG=v0.1.1

# Qwen server. Change ONLY the port if yours differs:
#   vLLM 8000 | llama.cpp 8080 | Ollama 11434 | LM Studio 1234
UPSTREAM_BASE=http://100.110.158.5:8080

# REQUIRED: docker compose refuses to start without it. Invent a long random
# value here on the NAS; clients send it as "Authorization: Bearer <key>"
# (i.e. their OpenAI api_key). Bearer is the only accepted form.
# The Qwen server's own --api-key (if any) is separate: the shim forwards
# the client's Authorization header upstream untouched, so if the upstream
# also checks a key, use the SAME value in both places.
SHIM_API_KEY=

# Cloudflare's silence limit is ~125s; these defaults stay well under it.
HEARTBEAT_INTERVAL=15
STREAM_COMMIT_DELAY=10
NONSTREAM_COMMIT_DELAY=45
MAX_REQUEST_SECONDS=1800

# Largest accepted request body (bytes, default 32 MiB); bigger gets 413.
MAX_BODY_BYTES=33554432
